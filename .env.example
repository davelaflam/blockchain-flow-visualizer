NODE_ENV=development

################################################################################
# API Key for AI-powered explanations                                          #
# If not provided, the app will use pre-generated explanations                 #
################################################################################

# Note: Replace the example keys below with your actual API keys.
#
# IMPORTANT: These keys are intentionally NOT prefixed with VITE_. They are
# read only by the Vite dev server (vite.config.ts) and injected into proxied
# API requests — they never reach the browser bundle or client code.

# OpenAI API Key
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key
# Get your API key from https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Optional: Set to 'true' to always use hardcoded explanations
# even if an API key is provided
# VITE_USE_HARDCODED_EXPLANATIONS=false

# Optional: Set to 'true' to enable debug logging
# VITE_DEBUG=false
